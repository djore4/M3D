# ------------------------------------------------------------------
# Copia este ficheiro para `.env.local` e preenche com os teus valores.
# NUNCA faças commit do .env.local (já está no .gitignore).
# ------------------------------------------------------------------

# URL público da aplicação (usado nos redirects do Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------
# Encontras estes valores em: Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# Service role key: SÓ usada no servidor (webhooks, uploads admin). Mantém secreta.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Email do administrador autorizado a aceder ao backoffice (/admin)
ADMIN_EMAIL=joao4duarte@gmail.com

# --- Stripe -------------------------------------------------------
# Encontras em: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Secret do webhook (Stripe Dashboard > Developers > Webhooks > endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxx
